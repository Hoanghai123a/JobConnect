# Production flow:
# chamcongchua.com -> Cloudflare Tunnel -> localhost:3000 -> JobConnect -> PB_URL -> PocketBase localhost:8090

# Server-side upstream for API proxy routes.
# Keep this private/local when PocketBase runs on the same Linux server.
PB_URL=http://127.0.0.1:8090

# Optional for SSR/build-time direct access.
# Browser traffic still goes through same-origin /api/public/pb.
VITE_PB_URL=http://127.0.0.1:8090

# Web Push notifications for installed PWA.
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Server-side PocketBase access used only by push notification API.
# Prefer PB_ADMIN_TOKEN on production, or use email/password for local setup.
PB_ADMIN_TOKEN=
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=
